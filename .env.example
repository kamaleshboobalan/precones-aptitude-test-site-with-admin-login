# Copy this file to .env and enter your MongoDB Atlas connection string.
# URL-encode special characters in the database user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/
MONGODB_DB=precon_recruitment
PORT=3000
HOST=0.0.0.0
# Run npm.cmd run admin:setup to securely configure the admin username/password hash.
# For an HTTPS reverse proxy, set ADMIN_COOKIE_SECURE=true and TRUST_PROXY=true,
# and make sure the app cannot be reached directly from outside that proxy.
